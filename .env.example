# Copy this file to .env.local and fill in real values for local development.
# .env.local is git-ignored; never commit real secrets.

# Public app info (exposed to the browser)
NEXT_PUBLIC_APP_NAME="Anavrin Property Admin"
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Server-only: backend API / database (used once real data replaces mock data)
DATABASE_URL=
API_SECRET_KEY=

# Auth (used once real admin login replaces the mock session)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# File uploads (listing images, builder logos, brochures, banners)
UPLOAD_BUCKET_URL=
UPLOAD_BUCKET_KEY=
